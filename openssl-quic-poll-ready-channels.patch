#
# OpenSSL QUIC: work-gated poll readout (Phase B, full)
# =====================================================
#
# Applies on top of openssl-quic-work-gated-port-tick.patch (Phase A).
#
# Problem
# -------
# Even with the engine tick work-gated, SSL_poll() still read out every poll
# item: one SSL_POLL_ITEM per established connection plus one per active stream.
# Each QUIC item ran the requested event tests under the domain mutex. Since a
# keepalive datagram or due timer wakes the poll loop at O(1) rate, the readout
# cost remained O(connections) per wake - the dominant idle4000 cost.
#
# What it does
# ------------
# 1. Ready-channel queue.
#    A QUIC_PORT keeps a queue of accepted connection channels which have
#    become ready for the application's poll readout. A channel enters the
#    queue when it is marked active (RX, TX/API action, handshake progress),
#    when it is ticked from the timer heap, or when it retains a
#    level-triggered condition (incoming stream or connection close). Channels
#    which have not yet been returned by SSL_accept_connection() are never
#    exposed; the listener IC event remains their readiness signal.
#
#    New public API:
#
#      size_t SSL_get_quic_ready_channels(SSL *ssl, SSL **channels,
#                                         size_t max_channels);
#
#    Passing a NULL array or max_channels == 0 returns the queued count
#    without draining. Otherwise up to max_channels accepted connection SSL
#    objects are removed from the queue and returned. The application can then
#    poll the listener plus only those connections (and their streams), instead
#    of passing every established connection to SSL_poll().
#
# 2. Quiescent-item fast path in the poll readout.
#    When SSL_poll() is called with SSL_POLL_FLAG_NO_HANDLE_EVENTS, a
#    handshake-complete connection with no pending RX/TX, no stream work, no
#    incoming stream queue, no close state and a future timer deadline returns
#    zero revents immediately. OS credit events are deliberately excluded
#    because they are level-triggered and not tied to pending channel work.
#    Existing batched domain locking is retained.
#
# No changes are made to SSL_poll() semantics, stream objects or the event
# masks. The application remains responsible for keeping stream items and any
# connection with unconsumed level-triggered events in its poll set.
#
# Files
# -----
#   doc/man3/SSL_get_quic_ready_channels.pod (new)
#   doc/man3/SSL_poll.pod
#   include/internal/quic_channel.h
#   include/internal/quic_port.h
#   include/internal/quic_ssl.h
#   include/openssl/ssl.h.in
#   ssl/quic/quic_channel.c
#   ssl/quic/quic_channel_local.h
#   ssl/quic/quic_impl.c
#   ssl/quic/quic_port.c
#   ssl/quic/quic_port_local.h
#   ssl/rio/poll_immediate.c
#   ssl/ssl_lib.c
#   test/quicapitest.c
#   util/libssl.num
#
# Validation
# ----------
#   make -j8: PASS
#   OpenSSL QUIC recipes: 19 files, 21 tests, 0 failures
#     (test_quic_cfq, test_quic_fc, test_quic_fifd, test_quic_lcidm,
#      test_quic_qlog, test_quic_radix, test_quic_rcidm, test_quic_record,
#      test_quic_srtm, test_quic_stream, test_quic_tserver, test_quic_txp,
#      test_quic_txpim, test_quic_wire, test_quic_ackm, test_quic_cc,
#      test_quic_srt_gen, test_quicapi, test_quicfaults)
#   New quicapitest coverage: test_get_quic_ready_channels verifies that
#     pending incoming connections are not exposed, accepted connections are
#     returned exactly once, and draining removes them from the ready queue.
#
# Apply from an OpenSSL source tree with:
#   git apply /path/to/openssl-quic-poll-ready-channels.patch
# or:
#   patch -p1 < /path/to/openssl-quic-poll-ready-channels.patch
#
# Generated against OpenSSL master 159cdbc600 (2026-11-20).
#
diff -ruN a/doc/man3/SSL_get_quic_ready_channels.pod b/doc/man3/SSL_get_quic_ready_channels.pod
--- a/doc/man3/SSL_get_quic_ready_channels.pod	1970-01-01 01:00:00.000000000 +0100
+++ b/doc/man3/SSL_get_quic_ready_channels.pod	2026-11-20 16:49:02.241314460 +0100
@@ -0,0 +1,71 @@
+=pod
+
+=head1 NAME
+
+SSL_get_quic_ready_channels -
+retrieve QUIC connections with pending poll events
+
+=head1 SYNOPSIS
+
+ #include <openssl/ssl.h>
+
+ size_t SSL_get_quic_ready_channels(SSL *ssl, SSL **channels,
+                                    size_t max_channels);
+
+=head1 DESCRIPTION
+
+SSL_get_quic_ready_channels() retrieves accepted QUIC connection SSL objects
+belonging to the QUIC listener I<ssl> which have become ready for polling.
+A channel becomes ready when it is touched by network input, by an application
+action, when one of its timers is due, or when it retains a level-triggered
+condition such as an incoming stream or a connection close.
+
+If I<channels> is NULL or I<max_channels> is zero, this function returns the
+number of ready channels without draining them from the ready queue.
+
+Otherwise, up to I<max_channels> ready connection SSL objects are written to
+the I<channels> array and removed from the ready queue. The returned SSL
+pointers are borrowed and remain owned by the normal QUIC connection lifecycle;
+the caller must not free them. A subsequent call can be used to drain any
+remaining channels.
+
+Channels which have not yet been returned by L<SSL_accept_connection(3)> are
+never returned by this function. Such connections are instead signalled by the
+B<SSL_POLL_EVENT_IC> event on the listener.
+
+This function can be used to avoid polling every established connection.
+Instead, the application can poll the listener and only those connections
+reported by SSL_get_quic_ready_channels(), using the same event masks and
+B<SSL_poll()> flags as before. This is particularly useful for large fleets of
+mostly idle connections, where a per-item readout over every connection would
+otherwise be the dominant cost.
+
+This function must only be called on a QUIC listener SSL object and may be
+called from multiple threads.
+
+=head1 RETURN VALUES
+
+SSL_get_quic_ready_channels() returns the number of ready channels written, or,
+when I<channels> is NULL or I<max_channels> is zero, the number of ready
+channels currently queued. It returns 0 if called on an SSL object other than
+a QUIC listener SSL object, or if no channels are ready.
+
+=head1 SEE ALSO
+
+L<SSL_poll(3)>, L<SSL_accept_connection(3)>, L<SSL_accept_stream(3)>,
+L<SSL_handle_events(3)>, L<openssl-quic(7)>
+
+=head1 HISTORY
+
+SSL_get_quic_ready_channels() was added in OpenSSL 4.0.
+
+=head1 COPYRIGHT
