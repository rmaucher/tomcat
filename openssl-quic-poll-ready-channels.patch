+int ossl_quic_channel_poll_can_skip(const QUIC_CHANNEL *ch)
+{
+    QUIC_STREAM_MAP *qsm = (QUIC_STREAM_MAP *)&ch->qsm;
+
+    /*
+     * The handshake layer can have non-network work pending, and a channel
+     * which is still marked active or dirty may have events which the next
+     * readout must report.
+     */
+    if (!ch->handshake_complete || ch->tick_dirty
+        || ch->on_active_channel_list)
+        return 0;
+
+    if (ossl_quic_channel_is_term_any(ch))
+        return 0;
+
+    if (ossl_quic_stream_map_get_total_accept_queue_len(qsm) > 0)
+        return 0;
+
+    if (ossl_quic_stream_map_has_pending_work(qsm))
+        return 0;
+
+    if (ossl_qrx_processed_read_pending(ch->qrx)
+        || ossl_qrx_unprocessed_read_pending(ch->qrx))
+        return 0;
+
+    if (ossl_qtx_get_queue_len_datagrams(ch->qtx) > 0)
+        return 0;
+
+    return ossl_time_compare(get_time((QUIC_CHANNEL *)ch),
+        ch->next_tick_deadline) < 0;
+}
