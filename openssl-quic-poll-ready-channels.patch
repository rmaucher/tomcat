+ * Queues an accepted channel for the application's ready-channel readout.
+ * Channels which have not yet been returned by SSL_accept_connection() are
+ * deliberately not exposed: the listener's IC event is their only readiness
+ * signal, and the application does not yet own their SSL object.
+ */
+static void port_mark_channel_ready(QUIC_CHANNEL *ch)
+{
+    QUIC_PORT *port = ch->port;
+
+    if (port == NULL || !ch->on_port_list || !ch->accepted
+        || ch->on_ready_channel_list || ch_get_user_ssl(ch) == NULL)
+        return;
+
+    ossl_list_ready_ch_insert_tail(&port->ready_channel_list, ch);
+    ch->on_ready_channel_list = 1;
