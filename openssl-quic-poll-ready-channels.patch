+static int test_get_quic_ready_channels(void)
+{
+    SSL_CTX *cctx = NULL, *sctx = NULL;
+    SSL *clientssl = NULL, *serverssl = NULL, *qlistener = NULL;
+    SSL *channels[4];
+    int testresult = 0;
+
+    if (!TEST_ptr(sctx = create_server_ctx())
+        || !TEST_ptr(cctx = create_client_ctx()))
+        goto err;
+
+    if (!create_quic_ssl_objects(sctx, cctx, &qlistener, &clientssl))
+        goto err;
+
+    if (!TEST_true(queue_incoming_connection(qlistener, clientssl)))
+        goto err;
+
+    /*
+     * A connection which has not yet been accepted is not exposed through the
+     * ready-channel API; the listener IC event is its only readiness signal.
+     */
+    if (!TEST_size_t_eq(SSL_get_quic_ready_channels(qlistener, NULL, 0), 0)
+        || !TEST_size_t_eq(SSL_get_quic_ready_channels(qlistener, channels,
+            OSSL_NELEM(channels)), 0))
+        goto err;
+
+    serverssl = SSL_accept_connection(qlistener, SSL_ACCEPT_CONNECTION_NO_BLOCK);
+    if (!TEST_ptr(serverssl))
+        goto err;
+
+    /*
+     * Once accepted, the channel is made ready for the application's readout,
+     * and draining it a second time must not return it again until new work
+     * occurs.
+     */
+    if (!TEST_size_t_eq(SSL_get_quic_ready_channels(qlistener, NULL, 0), 1)
+        || !TEST_size_t_eq(SSL_get_quic_ready_channels(qlistener, channels,
+            OSSL_NELEM(channels)), 1)
+        || !TEST_ptr_eq(channels[0], serverssl)
+        || !TEST_size_t_eq(SSL_get_quic_ready_channels(qlistener, channels,
+            OSSL_NELEM(channels)), 0))
+        goto err;
+
+    testresult = 1;
+
+err:
+    SSL_free(serverssl);
+    SSL_free(clientssl);
+    SSL_free(qlistener);
+    SSL_CTX_free(sctx);
+    SSL_CTX_free(cctx);
+
+    return testresult;
+}
