 /*
+ * SSL_get_quic_ready_channels
+ * ---------------------------
+ *
+ * Returns accepted connection channels which have become ready for polling,
+ * optionally draining up to max_channels of them into the caller-provided
+ * array. A call with channels == NULL or max_channels == 0 returns the number
+ * of queued channels without draining them.
+ *
+ * The returned SSL pointers are borrowed and remain owned by the normal
+ * connection lifecycle; the caller must not free them.
+ */
+QUIC_TAKES_LOCK
+size_t ossl_quic_get_quic_ready_channels(SSL *s, SSL **channels,
+    size_t max_channels)
+{
+    QCTX ctx;
+    size_t n;
+
+    if (!expect_quic_listener(s, &ctx))
+        return 0;
+
+    qctx_lock(&ctx);
+
+    if (channels == NULL || max_channels == 0)
+        n = ossl_quic_port_get_num_ready_channels(ctx.ql->port);
+    else
+        n = ossl_quic_port_get_ready_channels(ctx.ql->port, channels,
+            max_channels);
+
+    qctx_unlock(&ctx);
+    return n;
+}
